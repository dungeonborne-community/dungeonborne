{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DevKit",
  "version": "0.1.0",
  "identifier": "org.dungeonborne.devkit",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://127.0.0.1:1440",
    "beforeDevCommand": { "script": "trunk serve", "cwd": "../ui", "wait": false },
    "beforeBuildCommand": { "script": "trunk build --release", "cwd": "../ui" }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Dungeonborne DevKit",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
