{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dungeonborne Launcher",
  "version": "1.7.7",
  "identifier": "org.dungeonborne.launcher",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": { "script": "trunk serve", "cwd": "../ui", "wait": false },
    "beforeBuildCommand": { "script": "trunk build --release", "cwd": "../ui" }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Dungeonborne Launcher",
        "width": 1120,
        "height": 740,
        "minWidth": 920,
        "minHeight": 600,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' https: data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
