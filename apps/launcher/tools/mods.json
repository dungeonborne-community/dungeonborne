    "ru.rebuild-private": { "name": "Rebuild private (UnLua)",    "required": true,  "priority": 50, "paks": ["zzzzz_RebuildPrivate_P"] },
    "ru.balance":         { "name": "Season balance",             "required": true,  "priority": 60, "paks": ["zzzzzz_Balance_P"] },
    "ru.r14-fix":         { "name": "R14 equipment manager fix",  "required": true,  "priority": 70, "paks": ["zzzzzzz_BPFix_P"], "ue4ss": ["DungeonborneR14"] },
    "ru.chat-fix":        { "name": "World chat tab",             "required": true,  "priority": 71, "paks": ["zzzzzzz_ChatFix_P"] },
    "ru.client-hooks":    { "name": "Client hooks + dbnative",    "required": true,  "ue4ss": ["DungeonborneRuClient"] },
    "ru.client-probe":    { "name": "Client probe (diagnostics)", "required": false, "ue4ss": ["ClientProbe"] }
