{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Balance Studio",
  "version": "1.2.0",
  "identifier": "org.dungeonborne.balance-studio",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://127.0.0.1:1430",
    "beforeDevCommand": { "script": "trunk serve", "cwd": "../ui", "wait": false },
    "beforeBuildCommand": { "script": "trunk build --release", "cwd": "../ui" }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Balance Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 1100,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: kit: http://kit.localhost; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
