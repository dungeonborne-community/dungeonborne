<Project Sdk="Microsoft.NET.Sdk">

  <!-- dbdump: game assets -> JSON and PNG over CUE4Parse (FabianFG, Apache-2.0). Built and run by `ws dump`
       (tools/ws/core/src/dump.rs); docs/GAME_DATA.md. Versions are pinned here and in packages.lock.json. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>dbdump</AssemblyName>
    <Version>0.1.0</Version>
    <!-- restore only what packages.lock.json lists (hashes of every package) -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CUE4Parse" Version="1.2.2.202610" />
    <PackageReference Include="CUE4Parse-Conversion" Version="1.2.2.202610" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

</Project>
